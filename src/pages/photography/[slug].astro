---
import { getPhotography } from "@/lib/content";
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CountryAtlasDirectory from "@/components/photography/CountryAtlasDirectory.astro";
import manifest from "@/data/photography-manifest.json";
import { getGalleryCitiesForCountry } from "@/lib/photography-catalog";

export async function getStaticPaths() {
  const entries = await getPhotography();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"photography">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, description, dateRange, coverId } = entry.data;
const media = manifest.filter((item) => item.country === entry.id);
const cover = media.find((item) => item.id === coverId) ?? media[0];
const mappedCities = getGalleryCitiesForCountry(entry.id);
---

<BaseLayout
  title={`${name} — Travel by Stone Yang`}
  description={description}
  image={cover?.variants.at(-1)?.src}
  theme="dark"
  darkChrome
  clientTransitions
>
  <div
    class="country-page"
    data-country-route={entry.id}
    data-city-routes={JSON.stringify(mappedCities.map((city) => city.id))}
  >
    <CountryAtlasDirectory
      country={entry.id}
      countryName={name}
      description={description}
      year={dateRange.start.getFullYear()}
      frameCount={media.length}
      cities={mappedCities}
      media={media}
    />
    <article class="country-note"><Content /></article>
  </div>
</BaseLayout>

<script>
  const route = document.querySelector<HTMLElement>("[data-country-route]");
  if (route) {
    const query = new URLSearchParams(location.search);
    const legacyCity = query.get("city");
    const cityRoutes = JSON.parse(route.dataset.cityRoutes ?? "[]") as string[];
    if (legacyCity && cityRoutes.includes(legacyCity)) {
      const target = new URL(
        `/photography/${route.dataset.countryRoute}/${legacyCity}`,
        location.origin,
      );
      const photo = query.get("photo");
      if (photo) target.searchParams.set("photo", photo);
      location.replace(target.href);
    }

    const selectedCity = location.hash.startsWith("#city-")
      ? location.hash.slice(6)
      : "";
    const selectedCallout = cityRoutes.includes(selectedCity)
      ? document.querySelector<SVGElement>(
          `[data-country-city="${CSS.escape(selectedCity)}"]`,
        )
      : null;
    if (selectedCallout) {
      route.dataset.selectedCity = selectedCity;
      selectedCallout.dataset.selected = "true";
      const focusCallout = () => {
        scrollTo(0, 0);
        selectedCallout.focus({ preventScroll: true });
      };
      const settleCallout = () => requestAnimationFrame(focusCallout);
      addEventListener(
        "pagereveal",
        (event) => {
          const viewTransition = (
            event as Event & { viewTransition?: { finished: Promise<unknown> } }
          ).viewTransition;
          settleCallout();
          if (viewTransition) void viewTransition.finished.then(settleCallout);
        },
        { once: true },
      );
      if (document.readyState === "complete") settleCallout();
      else addEventListener("load", settleCallout, { once: true });
      requestAnimationFrame(() => requestAnimationFrame(focusCallout));
      setTimeout(focusCallout, 700);
    }
  }
</script>
