---
import { getPhotography } from "@/lib/content";
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CountryAtlasDirectory from "@/components/photography/CountryAtlasDirectory.astro";
import manifest from "@/data/photography-manifest.json";
import { getGalleryCitiesForCountry } from "@/lib/photography-catalog";

export async function getStaticPaths() {
  const entries = await getPhotography();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"photography">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, description, dateRange, coverId } = entry.data;
const media = manifest.filter((item) => item.country === entry.id);
const cover = media.find((item) => item.id === coverId) ?? media[0];
const mappedCities = getGalleryCitiesForCountry(entry.id);
---

<BaseLayout
  title={`${name} — Travel by Stone Yang`}
  description={description}
  image={cover?.variants.at(-1)?.src}
  imageAlt={cover?.alt}
  cosmicScene="universe"
  worldMode="quiet"
  returnScene="travel"
>
  <div
    class="country-page"
    data-country-route={entry.id}
    data-city-routes={JSON.stringify(mappedCities.map((city) => city.id))}
  >
    <CountryAtlasDirectory
      country={entry.id}
      countryName={name}
      description={description}
      year={dateRange.start.getFullYear()}
      frameCount={media.length}
      cities={mappedCities}
      media={media}
    />
    <article class="country-note"><Content /></article>
  </div>
</BaseLayout>

<script>
  let releaseCountryRoute = () => {};
  const cleanupCountryRoute = () => {
    releaseCountryRoute();
    releaseCountryRoute = () => {};
  };
  const initializeCountryRoute = () => {
    cleanupCountryRoute();
    const route = document.querySelector<HTMLElement>("[data-country-route]");
    if (!route) return;
    const events = new AbortController();
    let frame = 0;
    releaseCountryRoute = () => {
      events.abort();
      cancelAnimationFrame(frame);
    };
    const query = new URLSearchParams(location.search);
    const legacyCity = query.get("city");
    const cityRoutes = JSON.parse(route.dataset.cityRoutes ?? "[]") as string[];
    if (legacyCity && cityRoutes.includes(legacyCity)) {
      const target = new URL(
        `/photography/${route.dataset.countryRoute}/${legacyCity}`,
        location.origin,
      );
      const photo = query.get("photo");
      if (photo) target.searchParams.set("photo", photo);
      location.replace(target.href);
      return;
    }

    const selectedCity = location.hash.startsWith("#city-")
      ? location.hash.slice(6)
      : "";
    const selectedCallout = cityRoutes.includes(selectedCity)
      ? document.querySelector<SVGElement>(
          `[data-country-city="${CSS.escape(selectedCity)}"]`,
        )
      : null;
    if (selectedCallout) {
      route.dataset.selectedCity = selectedCity;
      selectedCallout.dataset.selected = "true";
      const focusCallout = () => {
        if (!selectedCallout.isConnected) return;
        scrollTo(0, 0);
        selectedCallout.focus({ preventScroll: true });
      };
      const settleCallout = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(focusCallout);
      };
      addEventListener("pagereveal", settleCallout, { signal: events.signal });
      settleCallout();
    }
  };
  document.addEventListener("astro:page-load", initializeCountryRoute);
  document.addEventListener("astro:before-swap", cleanupCountryRoute);
  initializeCountryRoute();
</script>

<style>
  .country-page {
    --collection-bg: var(--color-universe-paper);
    --collection-fg: var(--color-universe-ink);
    --collection-accent: color-mix(
      in srgb,
      var(--color-universe-coral) 58%,
      var(--collection-fg)
    );
    --collection-secondary: #746784;
    --collection-muted: color-mix(
      in srgb,
      var(--collection-fg) 76%,
      transparent
    );
    --collection-line: color-mix(
      in srgb,
      var(--color-universe-lavender) 60%,
      transparent
    );
    background: linear-gradient(180deg, transparent, #f5f0e8eb 85svh);
    color: var(--collection-fg);
  }
  .country-note {
    width: min(62rem, calc(100% - 2 * var(--page-gutter)));
    margin-inline: auto;
    margin-block: clamp(4rem, 9vw, 8rem);
    color: var(--collection-muted);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 400;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .country-note :global(a) {
    color: var(--collection-accent);
    text-underline-offset: 0.2em;
  }
</style>
