---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PhotographyGlobeLauncher from "@/components/photography/PhotographyGlobeLauncher.astro";
import { getPhotography } from "@/lib/content";
import manifest from "@/data/photography-manifest.json";
import { countryAtlasId } from "@/lib/photography-atlas/data";
import { getGalleryCitiesForCountry } from "@/lib/photography-catalog";
const entries = await getPhotography();
const countries = entries.map((entry) => {
  const countryPhotos = manifest.filter((item) => item.country === entry.id);
  const orderedPreviewPhotos = [
    ...countryPhotos.filter((item) => item.id === entry.data.coverId),
    ...countryPhotos.filter((item) => item.id !== entry.data.coverId),
  ].slice(0, 3);

  return {
    slug: entry.id,
    name: entry.data.name,
    isoCode: entry.data.isoCode,
    atlasId: countryAtlasId(entry.id),
    latitude: entry.data.coordinates.latitude,
    longitude: entry.data.coordinates.longitude,
    count: countryPhotos.length,
    previewImages: orderedPreviewPhotos.flatMap((item) => {
      const variant =
        item.variants.find((candidate) => candidate.width >= 960) ??
        item.variants.at(-1);
      if (!variant) return [];
      return [
        {
          src: variant.src,
          width: variant.width,
          height: Math.round((item.height / item.width) * variant.width),
          alt: item.alt,
        },
      ];
    }),
    cities: getGalleryCitiesForCountry(entry.id).map((city) => ({
      id: city.id,
      name: city.name,
      latitude: city.center.latitude,
      longitude: city.center.longitude,
    })),
  };
});
---

<BaseLayout
  title="Travel — Stone Yang"
  description="A geographic travel archive of photographs and field notes."
  theme="dark"
  immersive
  cosmicScene="travel"
>
  <div class="photography-atlas">
    <header class="atlas-heading">
      <p class="eyebrow">
        Travel archive / {String(manifest.length).padStart(3, "0")}
      </p><h1>Field <em>coordinates.</em></h1>
    </header>
    <PhotographyGlobeLauncher countries={countries} />
  </div>
</BaseLayout>
