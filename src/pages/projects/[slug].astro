---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCaseStudy from "@/components/projects/ProjectCaseStudy.astro";
import { getProjects } from "@/lib/content";

export async function getStaticPaths() {
  const entries = await getProjects();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, summary, year, cover } = entry.data;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: summary,
  creator: { "@type": "Person", name: "Stone Yang" },
  dateCreated: String(year),
};
---

<BaseLayout
  title={`${title} — Stone Yang`}
  description={summary}
  image={cover.src}
  theme="dark"
  cosmicScene="projects"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <ProjectCaseStudy entry={entry} />
</BaseLayout>
