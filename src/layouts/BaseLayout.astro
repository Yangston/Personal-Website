---
import "@/styles/global.css";
import Navigation from "@/components/motion/Navigation";
import { site } from "@/config/site";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: "light" | "dark";
}

const {
  title = site.title,
  description = site.description,
  image = "/og-default.svg",
  theme = "light"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class:list={[theme === "dark" && "dark"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "dark" ? "#11110f" : "#f4f0e8"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <style is:global>
      @view-transition { navigation: auto; }
      ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 420ms; }
    </style>
  </head>
  <body class="grain">
    <SpeedInsights />
    <a href="#main-content" class="fixed left-4 top-4 z-[100] -translate-y-24 bg-ink px-4 py-3 text-paper transition-transform focus:translate-y-0">Skip to content</a>
    <Navigation client:load currentPath={Astro.url.pathname} items={site.nav} />
    <main id="main-content"><slot /></main>
    <footer class="page-shell border-t border-ink/25 py-8 md:py-12">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <p class="font-display text-4xl leading-none md:text-6xl">Stone Yang</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold uppercase tracking-wider">
          {site.social.map((item) => <a class="underline decoration-transparent underline-offset-4 transition hover:decoration-current" href={item.href} target="_blank" rel="noreferrer">{item.label}</a>)}
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
      <p class="mt-10 text-xs uppercase tracking-[.16em]">© {new Date().getFullYear()} Stone Yang. Built with curiosity.</p>
    </footer>
  </body>
</html>
