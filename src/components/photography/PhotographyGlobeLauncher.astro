---
import ScenePanel from "@/components/cosmic/ScenePanel.astro";
import type { AtlasCountrySummary } from "@/lib/photography-atlas/data";
import { hongKongAtlasFeature } from "@/lib/photography-atlas/hong-kong";

interface Props {
  countries: AtlasCountrySummary[];
}

const { countries } = Astro.props;
const hongKong = hongKongAtlasFeature;
---

<section
  class="atlas-stage"
  data-atlas-launcher
  data-atlas-overlays-ready="false"
  aria-label="Travel atlas"
>
  <canvas
    class="atlas-canvas"
    data-atlas-canvas
    aria-label="Rotating globe with visited countries and cities"></canvas>
  <svg class="atlas-overlay" data-atlas-overlay aria-hidden="true">
    <g class="atlas-country-leaders">
      {
        countries.map((country) => (
          <polyline
            data-atlas-leader={country.slug}
            pathLength="1"
            points="0,0 0,0 0,0"
          />
        ))
      }
    </g>
    <path class="atlas-handoff-shape" data-atlas-handoff-shape></path>
  </svg>
  <nav class="atlas-country-labels" aria-label="Published countries">
    {
      countries.map((country, index) => (
        <a
          href={`/photography/${country.slug}`}
          data-atlas-country={country.slug}
          data-scene-panel-trigger={`country-preview-${country.slug}`}
          aria-label={`${country.name}, ${country.count} frames`}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>
            <span data-atlas-country-name>{country.name}</span>
          </strong>
          <small>{country.count} frames</small>
        </a>
      ))
    }
  </nav>
  <nav class="atlas-city-markers" aria-label="Visited cities">
    {
      countries.flatMap((country) =>
        country.cities.map((city) => (
          <a
            href={`/photography/${country.slug}/${city.id}`}
            data-atlas-city={city.id}
            data-atlas-city-country={country.slug}
            aria-label={`Open ${city.name}, ${country.name} photography archive`}
          >
            <span class="atlas-city-marker-glyph" aria-hidden="true" />
            <span class="atlas-city-tooltip">
              {city.name}
              <small>{country.isoCode}</small>
            </span>
          </a>
        )),
      )
    }
  </nav>
  {
    countries.map((country) => (
      <ScenePanel
        id={`country-preview-${country.slug}`}
        title={country.name}
        eyebrow={`${country.isoCode} / ${country.count} photographs`}
      >
        {country.previewImages.length > 0 && (
          <div class="country-preview-images">
            {country.previewImages.map((image) => (
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        )}
        <p class="country-preview-summary">
          {country.cities.length
            ? `Photographs from ${country.cities.map((city) => city.name).join(", ")}.`
            : "Explore the published photographs in this archive."}
        </p>
        <a
          class="country-preview-archive"
          href={`/photography/${country.slug}`}
        >
          Explore {country.name}
          <span aria-hidden="true">↗</span>
        </a>
        {country.cities.length > 0 && (
          <nav
            class="country-preview-cities"
            aria-label={`${country.name} city archives`}
          >
            <p>City archives</p>
            <ul>
              {country.cities.map((city) => (
                <li>
                  <a href={`/photography/${country.slug}/${city.id}`}>
                    {city.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </ScenePanel>
    ))
  }
  <p class="atlas-status" data-atlas-status aria-live="polite">
    Preparing the atlas…
  </p>
  <nav
    class="atlas-fallback"
    aria-label="Travel countries"
    data-atlas-fallback
    hidden
  >
    <p>The interactive atlas is unavailable. Continue with a country:</p>
    <ul>
      {
        countries.map((country) => (
          <li>
            <a href={`/photography/${country.slug}`} data-astro-reload>
              {country.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <noscript>
    <nav
      class="atlas-fallback atlas-fallback-noscript"
      aria-label="Travel countries without JavaScript"
    >
      <p>Choose a country to explore the archive:</p>
      <ul>
        {
          countries.map((country) => (
            <li>
              <a href={`/photography/${country.slug}`} data-astro-reload>
                {country.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </noscript>
  <script
    is:inline
    type="application/json"
    data-atlas-countries
    set:html={JSON.stringify(countries)}
  />
  <script
    is:inline
    type="application/json"
    data-atlas-hong-kong
    set:html={JSON.stringify(hongKong)}
  />
</section>

<style>
  :global([data-portfolio-universe]) .atlas-stage .atlas-city-markers a {
    color: #986a38;
  }

  :global([data-portfolio-universe]) .atlas-stage .atlas-city-marker-glyph {
    border-color: #fff7e9;
    box-shadow:
      0 0 0 2px #91603388,
      0 0 0.8rem #b9844b38;
  }

  :global([data-portfolio-universe])
    .atlas-stage
    .atlas-city-marker-glyph::before {
    border-color: #986a385c;
  }

  :global([data-portfolio-universe])
    .atlas-stage
    .atlas-city-marker-glyph::after {
    background: #65442c;
  }

  :global([data-portfolio-universe])
    .atlas-stage
    .atlas-city-markers
    a:is(:hover, :focus-visible, [data-active="true"]) {
    color: #a44830;
  }

  :global([data-portfolio-universe])
    .atlas-stage
    .atlas-city-markers
    a:is(:hover, :focus-visible)
    .atlas-city-marker-glyph {
    box-shadow:
      0 0 0 3px #a448308c,
      0 0 1rem #c4784c45;
  }

  :global([data-portfolio-universe])
    .atlas-stage
    .atlas-city-markers
    a:focus-visible {
    outline: 2px solid #873c2d;
    outline-offset: 0.15rem;
    border-radius: 50%;
  }

  :global([data-portfolio-universe]) .atlas-stage .atlas-city-tooltip small {
    color: #8a4933;
  }

  .country-preview-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .country-preview-images img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.2rem;
  }

  .country-preview-images img:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  .country-preview-summary {
    color: color-mix(in srgb, currentColor 76%, transparent);
  }

  .country-preview-archive {
    display: flex;
    min-height: 2.75rem;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.65rem;
    border-block: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    font-weight: 550;
  }

  .country-preview-archive span {
    flex: none;
  }

  .country-preview-cities {
    margin-top: 1.5rem;
  }

  .country-preview-cities p {
    margin-bottom: 0.5rem;
    font: 0.65rem/1.5 var(--font-code);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .country-preview-cities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .country-preview-cities a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-block: 0.5rem;
  }

  .country-preview-archive:hover,
  .country-preview-cities a:hover {
    color: var(--universe-signal, #ef4529);
  }
</style>
