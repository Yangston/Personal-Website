---
import type { GalleryCity } from "@/lib/photography-catalog";
import {
  countrySilhouettePath,
  countryTransitionPath,
} from "@/lib/photography-atlas/server";
import { placeCountryCallouts } from "@/lib/photography-atlas/data";

type ManifestPhoto = {
  id: string;
  region: string;
  alt: string;
  width: number;
  height: number;
  variants: { width: number; src: string }[];
};

interface Props {
  country: string;
  countryName: string;
  description: string;
  year: number;
  frameCount: number;
  cities: GalleryCity[];
  media: ManifestPhoto[];
}

const { country, countryName, description, year, frameCount, cities, media } =
  Astro.props;
const width = 1120;
const height = 720;
const silhouette = countrySilhouettePath(country, width, height);
const transitionPath = countryTransitionPath(country, width, height);
const seeds = cities.map((city) => {
  const marker = silhouette.project(
    city.center.longitude,
    city.center.latitude,
  ) ?? [width / 2, height / 2];
  return {
    id: city.id,
    markerX: marker[0],
    markerY: marker[1],
    width: city.samplePhotoIds.length > 1 ? 284 : 184,
    height: 150,
  };
});
const placements = new Map(
  placeCountryCallouts(seeds, width, height).map((item) => [item.id, item]),
);
const scenes = cities.map((city) => ({
  city,
  photos: media.filter((photo) => photo.region === city.region),
  samples: city.samplePhotoIds.flatMap((id) => {
    const photo = media.find((item) => item.id === id);
    return photo ? [photo] : [];
  }),
  marker: silhouette.project(city.center.longitude, city.center.latitude) ?? [
    width / 2,
    height / 2,
  ],
  callout: placements.get(city.id)!,
}));
---

<section
  class="country-map-hero"
  aria-labelledby="country-title"
  data-country-map-hero
>
  {
    scenes.map(({ city }) => (
      <span class="country-map-deep-link-anchor" id={`city-${city.id}`} />
    ))
  }
  <div class="country-map-intro">
    <a class="country-map-return" href="/#travel">
      <span aria-hidden="true">←</span> Return to the globe
    </a>
    <p class="country-kicker">
      <span>{year}</span><span>{frameCount} frames</span>
    </p>
    <header class="country-map-title-block">
      <p class="eyebrow">Travel archive</p>
      <h1 id="country-title">{countryName}</h1>
    </header>
    <p class="country-map-summary">{description}</p>
  </div>
  <div class="country-map-stage">
    <svg
      class="country-silhouette"
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby="country-silhouette-title country-silhouette-description"
    >
      <title id="country-silhouette-title">
        Visited cities in {countryName}
      </title>
      <desc id="country-silhouette-description"
        >A silhouette map with sample photographs arranged around each visited
        city.</desc
      >
      <path class="country-silhouette-land" d={silhouette.path}></path>
      {
        scenes.map(({ city, marker, samples, callout }) => (
          <a
            href={`/photography/${country}/${city.id}`}
            class="country-map-callout"
            data-country-city={city.id}
            aria-label={`Open ${city.name} city archive`}
          >
            <path
              class="country-map-leader"
              d={`M ${callout.left + callout.width / 2} ${callout.top + callout.height / 2} Q ${(callout.left + callout.width / 2 + marker[0]) / 2} ${(callout.top + callout.height / 2 + marker[1]) / 2 - 18} ${marker[0]} ${marker[1]}`}
            />
            {samples.map((sample, index) => {
              const variant =
                sample.variants.find((item) => item.width === 480) ??
                sample.variants[0];
              return (
                <image
                  href={variant.src}
                  x={callout.left + index * 104}
                  y={callout.top + 28}
                  width="176"
                  height="96"
                  preserveAspectRatio="xMidYMid slice"
                />
              );
            })}
            <rect
              class="country-map-photo-frame"
              x={callout.left - 8}
              y={callout.top + 20}
              width={callout.width + 16}
              height="112"
              rx="10"
            />
            <text
              class="country-map-city-name"
              x={callout.left + callout.width / 2}
              y={callout.top + 15}
              text-anchor="middle"
            >
              {city.name}
            </text>
            <circle
              class="country-map-marker-ring"
              cx={marker[0]}
              cy={marker[1]}
              r="13"
            />
            <circle
              class="country-map-marker"
              cx={marker[0]}
              cy={marker[1]}
              r="5"
            />
          </a>
        ))
      }
    </svg>
    <svg
      class="country-handoff-map"
      viewBox={`0 0 ${width} ${height}`}
      aria-hidden="true"
      data-country-handoff
      ><path class="country-handoff-shape" d={transitionPath}></path></svg
    >
  </div>
</section>

<style>
  .country-map-hero {
    height: auto;
    min-height: 0;
    overflow: clip;
    padding-bottom: clamp(1rem, 4vw, 4rem);
  }
  .country-map-intro {
    position: relative;
    inset: auto;
    padding: clamp(6.5rem, 12vh, 8rem) var(--page-gutter) 0;
    pointer-events: auto;
  }
  .country-map-return {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    margin-bottom: 1.5rem;
    font: 0.65rem/1.5 var(--font-code);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .country-map-return:hover,
  .country-map-return:focus-visible {
    color: var(--collection-accent);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  .country-kicker {
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--collection-line);
    color: var(--collection-muted);
  }
  .country-map-title-block h1 {
    line-height: 0.94;
    overflow-wrap: anywhere;
  }
  .country-map-summary {
    grid-column: 8 / -1;
    align-self: end;
    margin-top: 2rem;
    color: var(--collection-muted);
  }
  .country-map-stage {
    position: relative;
    inset: auto;
    height: clamp(25rem, 57vw, 48rem);
    margin: 1rem var(--page-gutter) 0;
  }
  .country-silhouette-land,
  .country-handoff-shape {
    fill: color-mix(
      in srgb,
      var(--color-universe-pearl) 70%,
      var(--color-universe-paper)
    );
    stroke: color-mix(
      in srgb,
      var(--color-universe-lavender) 72%,
      var(--collection-fg)
    );
    stroke-width: 1.25;
  }
  .country-map-leader {
    stroke: color-mix(in srgb, var(--collection-fg) 38%, transparent);
    stroke-width: 1;
  }
  .country-map-photo-frame {
    stroke: color-mix(in srgb, var(--color-universe-lavender) 80%, transparent);
  }
  .country-map-city-name {
    fill: var(--collection-fg);
    font-weight: 520;
  }
  .country-map-marker-ring {
    fill: #ff8d6d26;
    stroke: var(--collection-accent);
  }
  .country-map-marker {
    fill: var(--collection-accent);
  }
  .country-city-directory {
    border-color: var(--collection-line);
    background: linear-gradient(135deg, #ffffff57, #dce9ec33);
  }
  .country-city-directory > header h2 {
    line-height: 0.98;
    overflow-wrap: anywhere;
  }
  .country-city-directory > header .eyebrow {
    color: var(--collection-accent);
  }
  .country-city-grid {
    gap: 1rem;
    background: transparent;
  }
  .country-city-grid article {
    border: 1px solid var(--collection-line);
    background: #faf6ee82;
    border-radius: 0.35rem;
    transition: background 250ms ease;
    overflow: hidden;
  }
  .country-city-grid article:hover,
  .country-city-grid article:focus-within {
    background: #e6e2ed80;
  }
  .country-city-grid a {
    min-height: 21rem;
    padding: 0 0 1.6rem;
    height: 100%;
  }
  .country-city-grid a > :not(.city-directory-image) {
    margin-inline: clamp(1.25rem, 2.5vw, 2rem);
  }
  .city-directory-image {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin-bottom: 1.4rem;
    background: var(--color-universe-pearl);
  }
  .city-directory-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out-expo);
  }
  .country-city-grid a:is(:hover, :focus-visible) img {
    transform: scale(1.035);
  }
  .country-city-grid h3 {
    margin-top: 0.7rem;
    margin-bottom: 0.7rem;
    font-weight: 500;
    font-size: clamp(2rem, 2.7vw, 3rem);
  }
  .country-city-grid a > p {
    margin-top: 0;
    margin-bottom: 0.8rem;
  }
  .country-city-grid a > p {
    color: var(--collection-muted);
  }
  .city-directory-meta {
    font: 0.62rem/1.6 var(--font-code);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .country-city-grid a > span {
    margin-top: auto;
    padding-top: 2rem;
    color: var(--collection-accent);
  }
  @media (max-width: 700px) {
    .country-map-intro {
      padding-top: 6.5rem;
    }
    .country-map-title-block h1 {
      font-size: clamp(3rem, 15vw, 4.8rem);
      line-height: 0.94;
    }
    .country-map-summary {
      grid-column: 1 / -1;
      margin-top: 0.7rem;
      font-size: 0.9rem;
      line-height: 1.55;
    }
    .country-map-stage {
      height: clamp(21rem, 80vw, 32rem);
      margin-inline: 0.25rem;
    }
    .country-map-city-name {
      font-size: 30px;
    }
    .country-city-grid a {
      min-height: 17rem;
    }
  }
</style>

<section
  class="country-city-directory"
  aria-labelledby="country-directory-title"
>
  <header>
    <p class="eyebrow">Field notes / routes</p><h2 id="country-directory-title">
      Where the frames <em>landed.</em>
    </h2>
  </header>
  <div class="country-city-grid">
    {
      scenes.map(({ city, photos, samples }, index) => (
        <article id={`city-card-${city.id}`}>
          <a
            href={`/photography/${country}/${city.id}`}
            data-astro-prefetch="hover"
          >
            {(samples[0] ?? photos[0]) &&
              (() => {
                const photo = samples[0] ?? photos[0];
                const preview =
                  photo.variants.find((variant) => variant.width >= 960) ??
                  photo.variants.at(-1)!;
                return (
                  <div class="city-directory-image">
                    <img
                      src={preview.src}
                      srcset={photo.variants
                        .map((variant) => `${variant.src} ${variant.width}w`)
                        .join(", ")}
                      sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1100px) 45vw, 30vw"
                      width={photo.width}
                      height={photo.height}
                      alt={photo.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                );
              })()}
            <p class="city-directory-meta">
              0{index + 1} / {photos.length} frames
            </p>
            <h3>{city.name}</h3>
            <p>{city.description}</p>
            <span>Open city gallery →</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
