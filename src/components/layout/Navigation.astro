---
import { site } from "@/config/site";

type Item = { readonly label: string; readonly href: string };

interface Props {
  currentPath: string;
  items: readonly Item[];
  overlay?: boolean;
  lightOverlay?: boolean;
}

const {
  currentPath,
  items,
  overlay = false,
  lightOverlay = false,
} = Astro.props;
const universeNavigation = lightOverlay;
const currentFor = (href: string) => {
  const hash = href.split("#")[1];
  const active = hash
    ? currentPath === "/"
      ? hash === "home"
      : hash === "projects"
        ? currentPath.startsWith("/projects/")
        : hash === "travel"
          ? currentPath.startsWith("/photography/")
          : false
    : href === "/"
      ? currentPath === "/"
      : currentPath.startsWith(href);
  return active ? (currentPath === "/" ? "location" : "page") : undefined;
};
---

<header
  class:list={[
    "site-navigation sticky top-0 z-50 border-b border-ink/20 bg-paper/90 backdrop-blur-xl",
    overlay && "site-navigation-overlay",
    lightOverlay && "site-navigation-overlay-light",
    universeNavigation && "site-navigation-universe",
  ]}
>
  <nav
    aria-label="Primary"
    class="flex h-18 items-center justify-between px-[var(--page-gutter)] md:h-22"
  >
    <a
      href="/"
      aria-label="Stone Yang, home"
      class="font-display text-3xl font-semibold tracking-[-.08em] md:text-4xl"
      >SY</a
    >
    <ul class="hidden items-center gap-8 md:flex">
      {
        items.map((item, index) => (
          <li>
            <a
              href={item.href}
              aria-current={currentFor(item.href)}
              class="group flex items-baseline gap-2 text-sm font-semibold uppercase tracking-[.12em] transition-transform hover:-translate-y-1"
            >
              {!universeNavigation && (
                <span class="text-[10px] text-signal">0{index + 1}</span>
              )}
              <span data-navigation-label>{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="navigation-contact">
        <a href={`mailto:${site.email}`}><span>Let’s talk</span></a>
      </li>
    </ul>
    <details class="mobile-navigation relative md:hidden">
      <summary
        class="grid size-11 cursor-pointer list-none place-items-center border border-ink"
        aria-label="Open navigation"
      >
        <span aria-hidden="true" class="mobile-navigation-open text-xl"
          >Menu</span
        >
        <span aria-hidden="true" class="mobile-navigation-close text-xl"
          >Close</span
        >
      </summary>
      <div
        class="absolute right-[calc(-1*var(--page-gutter))] top-[calc(100%+1.05rem)] w-screen border-b border-ink bg-cobalt px-[var(--page-gutter)] py-10 text-paper"
      >
        <ul class="space-y-4">
          {
            items.map((item, index) => (
              <li>
                <a
                  class="flex items-baseline gap-4 font-display text-5xl"
                  href={item.href}
                  aria-current={currentFor(item.href)}
                >
                  {!universeNavigation && (
                    <span class="font-sans text-xs">0{index + 1}</span>
                  )}
                  <span data-navigation-label>{item.label}</span>
                </a>
              </li>
            ))
          }
          <li class="navigation-contact">
            <a href={`mailto:${site.email}`}>Let’s talk</a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>

<script>
  const navigationWindow = window as Window & {
    __portfolioNavigationInitialized?: boolean;
  };
  if (!navigationWindow.__portfolioNavigationInitialized) {
    navigationWindow.__portfolioNavigationInitialized = true;
    const openMenu = () =>
      document.querySelector<HTMLDetailsElement>(".mobile-navigation[open]");
    const labelMenu = (details: HTMLDetailsElement) => {
      details
        .querySelector("summary")
        ?.setAttribute(
          "aria-label",
          details.open ? "Close navigation" : "Open navigation",
        );
    };
    const closeMenu = (details: HTMLDetailsElement) => {
      details.open = false;
      labelMenu(details);
    };
    document.addEventListener(
      "toggle",
      (event) => {
        if (
          event.target instanceof HTMLDetailsElement &&
          event.target.matches(".mobile-navigation")
        )
          labelMenu(event.target);
      },
      true,
    );
    document.addEventListener("click", (event) => {
      const details = openMenu();
      const target = event.target instanceof Element ? event.target : null;
      if (
        details &&
        target &&
        (!details.contains(target) || target.closest("a"))
      )
        closeMenu(details);
    });
    document.addEventListener("focusin", (event) => {
      const details = openMenu();
      if (
        details &&
        event.target instanceof Node &&
        !details.contains(event.target)
      )
        closeMenu(details);
    });
    document.addEventListener("keydown", (event) => {
      const details = openMenu();
      if (event.key !== "Escape" || !details?.open) return;
      event.preventDefault();
      closeMenu(details);
      details
        .querySelector<HTMLElement>("summary")
        ?.focus({ preventScroll: true });
    });
    matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      const details = openMenu();
      if (event.matches && details) closeMenu(details);
    });
  }
</script>

<style>
  .site-navigation-universe {
    border: 0;
    color: #231e1b;
    background: transparent;
    backdrop-filter: none;
  }
  .site-navigation-universe nav > a {
    font: 600 2.3rem/1 var(--font-universe-display, var(--font-display));
    letter-spacing: -0.08em;
    text-decoration: none;
  }
  .site-navigation-universe nav > ul {
    gap: clamp(1.35rem, 2.5vw, 2.8rem);
  }
  .site-navigation-universe nav > ul a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    font: 500 0.75rem/1.4 var(--font-code);
    letter-spacing: 0.19em;
    transform: none;
    transition: color 180ms ease;
  }
  .site-navigation-universe a:is(:hover, [aria-current]) {
    color: #a73827;
  }
  .site-navigation-universe a[aria-current] [data-navigation-label] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.55rem;
  }
  .site-navigation-universe a:focus-visible,
  .site-navigation-universe summary:focus-visible {
    outline: 1px solid #b5412c;
    outline-offset: 0.4rem;
  }
  .site-navigation-universe .mobile-navigation summary {
    width: auto;
    min-width: 2.75rem;
    border: 0;
  }
  .site-navigation-universe .mobile-navigation summary span {
    font: 0.64rem/1.4 var(--font-code);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .site-navigation-universe .mobile-navigation > div {
    top: calc(100% + 0.85rem);
    border-color: #79605025;
    padding-block: 1.8rem 2.5rem;
    background: #faf4ecef;
    color: #231e1b;
    box-shadow: 0 1rem 2.5rem #704b3912;
    backdrop-filter: blur(16px);
  }
  .mobile-navigation > div {
    max-height: calc(100svh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-navigation[open] > div {
    animation: navigation-enter 180ms ease-out both;
  }
  .site-navigation-universe nav > ul .navigation-contact {
    padding-left: clamp(0.8rem, 1.7vw, 1.6rem);
    border-left: 1px solid #79605035;
  }
  .site-navigation-universe .navigation-contact a {
    color: #8b3528;
  }
  .site-navigation-universe .mobile-navigation .navigation-contact {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid #79605025;
  }
  .site-navigation-universe .mobile-navigation .navigation-contact a {
    font: 500 0.75rem/1.4 var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .site-navigation-universe .mobile-navigation ul {
    display: grid;
    gap: 0.8rem;
  }
  .site-navigation-universe .mobile-navigation li + li {
    margin-top: 0;
  }
  .site-navigation-universe .mobile-navigation a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    width: fit-content;
    font: 500 2.9rem/1.2 var(--font-universe-display, var(--font-display));
    letter-spacing: -0.035em;
  }
  @media (max-width: 700px) {
    .site-navigation-universe nav > a {
      font-size: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation[open] > div {
      animation: none;
    }
    .site-navigation-universe nav > ul a {
      transition: none;
    }
  }
  @keyframes navigation-enter {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
