---
import { getPhotography } from "@/lib/content";
import { countryAtlasId } from "@/lib/photography-atlas/data";
import {
  HOME_EARTH_ROTATION,
  TRAVEL_EARTH_ROTATION,
} from "@/lib/cosmic-transitions/earth";
import { earthArtwork } from "@/lib/portfolio-universe/earth-artwork";
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const visited = (await getPhotography()).map(({ id }) =>
  String(countryAtlasId(id)),
);
const poses = [
  { id: "home", rotation: HOME_EARTH_ROTATION },
  { id: "travel", rotation: TRAVEL_EARTH_ROTATION },
].map((pose) => ({ id: pose.id, ...earthArtwork(pose.rotation, visited) }));
---

<svg
  class:list={["cosmic-earth", className]}
  data-cosmic-earth
  viewBox="0 0 360 360"
  aria-hidden="true"
>
  <circle class="cosmic-earth-ocean" cx="180" cy="180" r="164"></circle>
  {
    poses.map((pose) => (
      <g data-earth-pose={pose.id}>
        <>
          <path class="cosmic-earth-land" d={pose.land} />
          <path class="cosmic-earth-visited" d={pose.visited} />
        </>
      </g>
    ))
  }
  <circle class="cosmic-earth-rim" cx="180" cy="180" r="164"></circle>
</svg>
<style>
  .cosmic-earth {
    display: block;
    overflow: visible;
  }
  .cosmic-earth-ocean {
    fill: #dce9ec;
  }
  .cosmic-earth-land {
    fill: #f5f0e8;
    stroke: rgba(67, 54, 65, 0.28);
    stroke-width: 0.35;
  }
  .cosmic-earth-visited {
    fill: #bbb2d2;
  }
  .cosmic-earth-rim {
    fill: none;
    stroke: rgba(67, 54, 65, 0.12);
    stroke-width: 0.35;
  }
  [data-earth-pose="travel"] {
    display: none;
  }
  [data-earth-pose="travel"] .cosmic-earth-visited {
    fill: #ff8d6d;
  }
  :global(html[data-world-scene="travel"]) [data-earth-pose="travel"] {
    display: block;
  }
  :global(html[data-world-scene="travel"]) [data-earth-pose="home"] {
    display: none;
  }
</style>
