---
import type { CollectionEntry } from "astro:content";
import PhotographyGlobeLauncher from "@/components/photography/PhotographyGlobeLauncher.astro";
import ProjectConstellationField from "@/components/projects/ProjectConstellationField.astro";
import AboutClouds from "./AboutClouds.astro";
import HomeDestinationRegions from "./HomeDestinationRegions.astro";
import type { AtlasCountrySummary } from "@/lib/photography-atlas/data";
import { withAuthoredEntries } from "@/lib/portfolio-universe/state";
import { almanac } from "@/config/almanac";
import { site } from "@/config/site";
import { ABOUT_PILLARS } from "@/lib/portfolio-universe/about-pillars";
interface Props {
  projects: CollectionEntry<"projects">[];
  countries: AtlasCountrySummary[];
  photographCount: number;
}
const { projects, countries, photographCount } = Astro.props;
const tracks = withAuthoredEntries(
  ABOUT_PILLARS.map((pillar) => ({
    ...pillar,
    entries:
      pillar.id === "hobbies"
        ? almanac.hobbies.map(({ title }) => ({ title, credit: "" }))
        : [...almanac[pillar.id]],
  })),
);
---

<div
  class="portfolio-universe"
  data-portfolio-universe
  data-active-scene="home"
  data-enhanced="false"
  data-renderer-type="pending"
  data-webgl-ready="false"
>
  <section
    id="home"
    class="universe-scene universe-home"
    data-universe-scene="home"
    data-scene-active="true"
    aria-labelledby="universe-home-title"
  >
    <div class="universe-home-copy">
      <p class="eyebrow">A small part of a wider universe</p>
      <h1 id="universe-home-title" tabindex="-1">
        <span>Stone</span>
        <em>Yang.</em>
      </h1>
      <p class="universe-role">Engineer, photographer, curious builder.</p>
    </div>
    <HomeDestinationRegions
      projectIds={projects.map((project) => project.id)}
    />
    <div class="universe-colophon">
      <p class="universe-explore">
        {site.location}
        <span aria-hidden="true"> / </span> A little curiosity goes a long way.
      </p>
      <a href={site.resume} target="_blank" rel="noreferrer"
        >Résumé <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>

  <section
    id="about"
    class="universe-scene universe-about"
    data-universe-scene="about"
    data-scene-active="false"
    aria-labelledby="universe-about-title"
  >
    <header class="universe-section-heading about-heading">
      <p class="eyebrow">Beyond the work</p>
      <h2 id="universe-about-title" tabindex="-1">A closer <em>look.</em></h2>
      <p>{almanac.introduction}</p>
      <dl class="almanac-coordinates">
        {
          almanac.origin && (
            <div>
              <>
                <dt>From</dt>
                <dd>{almanac.origin}</dd>
              </>
            </div>
          )
        }
        <div><dt>Currently in</dt><dd>{almanac.currentLocation}</dd></div>
      </dl>
    </header>
    <AboutClouds />
    <div class="almanac-static">
      {
        tracks.map((track) => (
          <section id={`almanac-content-${track.id}`}>
            <>
              <h3>{track.label}</h3>
              <ul>
                {track.entries.map((entry) => (
                  <li>
                    {entry.title}
                    {entry.credit && <span> — {entry.credit}</span>}
                  </li>
                ))}
              </ul>
            </>
          </section>
        ))
      }
    </div>
    <a class="universe-return" href="/#home" data-universe-link
      >← Back to the wider view</a
    >
    <nav class="about-connect" aria-label="Connect with Stone">
      <a href={`mailto:${site.email}`}
        >Say hello <span aria-hidden="true">↗</span></a
      >
      <a href={site.resume} target="_blank" rel="noreferrer"
        >Résumé <span aria-hidden="true">↗</span></a
      >
      {
        site.social
          .filter((item) => item.label !== "Instagram")
          .map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer">
              {item.label} <span aria-hidden="true">↗</span>
            </a>
          ))
      }
    </nav>
  </section>

  <ProjectConstellationField projects={projects} />

  <section
    id="travel"
    class="universe-scene universe-travel"
    data-universe-scene="travel"
    data-scene-active="false"
    aria-labelledby="universe-travel-title"
  >
    <div class="photography-atlas">
      <header class="atlas-heading universe-section-heading">
        <p class="eyebrow">{photographCount} moments on Earth</p>
        <h2 id="universe-travel-title" tabindex="-1">
          A world of <em>stories.</em>
        </h2>
        <p>Small moments, a wider world. Choose a country to explore.</p>
      </header>
      <PhotographyGlobeLauncher countries={countries} />
      <details class="travel-directory">
        <summary>Browse the archive</summary><nav
          aria-label="Travel archive directory"
        >
          <ul>
            {
              countries.map((country) => (
                <li>
                  <>
                    <a href={`/photography/${country.slug}`}>
                      {country.name}
                      <small>{country.count} frames</small>
                    </a>
                    <ul>
                      {country.cities.map((city) => (
                        <li>
                          <a href={`/photography/${country.slug}/${city.id}`}>
                            {city.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
      <a
        class="travel-return-link universe-return"
        href="/#home"
        data-universe-link>← Back to the wider view</a
      >
    </div>
  </section>
  <p class="universe-announcer" data-universe-announcer aria-live="polite"></p>
</div>

<script>
  import { initializePortfolioUniverse } from "@/lib/portfolio-universe/controller";
  type UniverseWindow = Window & {
    __portfolioUniverseCleanup?: () => void;
    __portfolioUniverseLifecycleInitialized?: boolean;
  };
  const universeWindow = window as UniverseWindow;
  const initialize = () => {
    void initializePortfolioUniverse();
  };
  if (!universeWindow.__portfolioUniverseLifecycleInitialized) {
    universeWindow.__portfolioUniverseLifecycleInitialized = true;
    document.addEventListener("astro:page-load", initialize);
    document.addEventListener("astro:before-swap", () => {
      universeWindow.__portfolioUniverseCleanup?.();
      delete universeWindow.__portfolioUniverseCleanup;
    });
  }
  initialize();
</script>

<style>
  :global(:root) {
    --home-about-x: 80vw;
    --home-about-y: 22svh;
    --home-projects-x: 60vw;
    --home-projects-y: 38svh;
    --home-travel-x: 66vw;
    --home-travel-y: 56svh;
  }
  .portfolio-universe {
    position: relative;
    color: var(--color-universe-ink);
    --universe-signal: #b5412c;
  }
  :global(.universe-scene) {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
    scroll-margin-top: 6rem;
  }
  :global(html[data-world-scene]) .portfolio-universe {
    width: 100%;
    height: 100svh;
    overflow: clip;
  }
  :global(html[data-world-scene]) .portfolio-universe :global(.universe-scene) {
    position: absolute;
    inset: 0;
    min-height: 0;
    height: 100%;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-world-scene="home"])
    .portfolio-universe:not([data-enhanced="true"])
    #home,
  :global(html[data-world-scene="about"])
    .portfolio-universe:not([data-enhanced="true"])
    #about,
  :global(html[data-world-scene="projects"])
    .portfolio-universe:not([data-enhanced="true"])
    :global(#projects),
  :global(html[data-world-scene="travel"])
    .portfolio-universe:not([data-enhanced="true"])
    #travel,
  .portfolio-universe[data-enhanced="true"]
    :global(.universe-scene[data-scene-active="true"]) {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  .portfolio-universe[data-enhanced="true"]
    :global(.universe-scene[data-scene-staging="true"]) {
    visibility: visible;
  }
  .universe-home {
    position: relative;
    padding: clamp(9rem, 23svh, 15rem) var(--page-gutter) 5rem;
  }
  .universe-home-copy {
    position: relative;
    z-index: 2;
    width: min(35rem, 43vw);
    pointer-events: none;
  }
  .universe-home-copy :is(h1, p) {
    pointer-events: auto;
    width: fit-content;
    max-width: 100%;
  }
  .universe-colophon {
    position: absolute;
    bottom: max(1.5rem, 4svh);
    left: var(--page-gutter);
    right: var(--page-gutter);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    pointer-events: none;
  }
  .universe-colophon .universe-explore {
    position: static;
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    text-transform: none;
  }
  .universe-colophon a,
  .about-connect a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: #58483e;
    font: 0.65rem/1.5 var(--font-code);
    text-decoration: none;
    pointer-events: auto;
  }
  .universe-colophon a:hover,
  .about-connect a:hover {
    color: #973b2b;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .about-connect {
    position: absolute;
    bottom: 1.8rem;
    right: var(--page-gutter);
    z-index: 8;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.4rem;
  }
  .portfolio-universe .eyebrow {
    margin: 0;
    color: inherit;
    font: 500 0.65rem/1.6 var(--font-code);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .universe-home h1 {
    margin: 1.35rem 0 0;
    font: 600 clamp(7rem, 8.2vw, 9.25rem)/0.78
      var(--font-universe-display, var(--font-display));
    font-optical-sizing: none;
    font-variation-settings: "opsz" 48;
    letter-spacing: -0.067em;
  }
  .universe-home h1 > span,
  .universe-home h1 > em {
    display: block;
  }
  .universe-home h1 > em {
    margin-top: 0.06em;
  }
  h1 em,
  .universe-section-heading h2 em {
    color: var(--universe-signal);
    font-weight: inherit;
  }
  h1:focus,
  h2:focus {
    outline: none;
  }
  .universe-role {
    margin: 2.25rem 0 0;
    max-width: 30rem;
    font-size: clamp(0.95rem, 1.35vw, 1.35rem);
    font-weight: 450;
    line-height: 1.5;
    letter-spacing: 0.005em;
  }
  .universe-explore {
    position: absolute;
    bottom: max(2.3rem, 7.5svh);
    left: var(--page-gutter);
    z-index: 2;
    margin: 0;
    color: #48403d;
    font: 0.56rem/1.5 var(--font-code);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .universe-about {
    padding: clamp(9rem, 24svh, 16rem) var(--page-gutter) 5rem;
  }
  .universe-section-heading {
    position: relative;
    z-index: 2;
    width: min(31rem, 39vw);
  }
  .universe-section-heading h2 {
    margin: 1.2rem 0 0;
    font: 600 clamp(4rem, 5.8vw, 6.75rem)/0.9
      var(--font-universe-display, var(--font-display));
    font-optical-sizing: none;
    font-variation-settings: "opsz" 48;
    letter-spacing: -0.05em;
  }
  .universe-section-heading > p:last-of-type:not(.eyebrow) {
    margin: 1.6rem 0 0;
    max-width: 25rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: #49413f;
  }
  .almanac-coordinates {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    margin: 2.2rem 0 0;
  }
  .almanac-coordinates dt {
    margin-bottom: 0.5rem;
    font: 0.55rem/1.4 var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: #665963;
  }
  .almanac-coordinates dd {
    margin: 0;
    font-size: 0.85rem;
  }
  .almanac-static {
    margin-top: 4rem;
    display: grid;
    gap: 1.5rem;
  }
  .almanac-static h3 {
    font: 500 1.8rem var(--font-universe-display, var(--font-display));
  }
  .portfolio-universe[data-enhanced="true"] .almanac-static,
  :global(html[data-world-scene]) .almanac-static {
    display: none;
  }

  .universe-return {
    position: absolute;
    bottom: 1.8rem;
    left: var(--page-gutter);
    z-index: 5;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    font: 0.57rem/1.5 var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: #645650;
  }
  .universe-return:hover {
    color: var(--universe-signal);
  }
  .photography-atlas {
    position: relative;
    height: 100%;
    min-height: 100svh;
  }
  .universe-travel .atlas-heading {
    position: absolute;
    top: clamp(8.5rem, 23svh, 15rem);
    left: var(--page-gutter);
    width: min(24rem, 30vw);
  }
  .universe-travel .atlas-heading h2 {
    max-width: 7ch;
    font-size: clamp(3.5rem, 5.1vw, 6rem);
  }
  .universe-travel .atlas-heading > p:last-child {
    max-width: 19rem;
    font-size: 0.85rem;
  }
  .travel-directory {
    position: absolute;
    left: var(--page-gutter);
    bottom: 6rem;
    z-index: 6;
    width: min(18rem, 28vw);
    font-size: 0.8rem;
  }
  .travel-directory summary {
    cursor: pointer;
    min-height: 2.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #78605340;
    font: 0.6rem/1.5 var(--font-code);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .travel-directory[open] {
    background: #fbf5edf5;
    padding: 1.25rem;
    max-height: 60svh;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid #78605326;
    box-shadow: 0 1rem 3rem #5c414010;
  }
  .travel-directory ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .travel-directory nav > ul {
    padding-top: 1rem;
  }
  .travel-directory a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .travel-directory li ul {
    padding: 0.2rem 0 0 1rem;
    gap: 0.1rem;
    font-size: 0.72rem;
  }
  .travel-directory small {
    color: #6b5d55;
    font-size: 0.6rem;
  }
  .universe-announcer {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 700px) {
    .universe-home {
      padding: clamp(7rem, 16.5svh, 9rem) var(--page-gutter) 4rem;
    }
    .universe-home-copy {
      width: min(100%, 23rem);
    }
    .portfolio-universe .eyebrow {
      font-size: 0.49rem;
      letter-spacing: 0.16em;
    }
    .universe-home h1 {
      margin-top: 1.1rem;
      font-size: clamp(5rem, 24vw, 7rem);
      line-height: 0.8;
    }
    .universe-role {
      max-width: 19rem;
      font-size: 0.84rem;
      margin-top: 1.7rem;
    }
    .universe-colophon {
      bottom: max(0.7rem, env(safe-area-inset-bottom));
      gap: 0.3rem;
    }
    .universe-colophon .universe-explore {
      max-width: 22ch;
      line-height: 1.7;
      font-size: 0.56rem;
    }
    .about-connect {
      bottom: max(0.8rem, env(safe-area-inset-bottom));
      left: auto;
      right: var(--page-gutter);
      gap: 0 0.8rem;
    }
    .about-connect a {
      font-size: 0.59rem;
      gap: 0.3rem;
    }
    .about-connect a:nth-child(n + 3) {
      display: none;
    }
    .universe-explore {
      bottom: max(1.5rem, 5svh);
      font-size: 0.48rem;
      letter-spacing: 0.15em;
    }
    .universe-about {
      padding: clamp(6.75rem, 15svh, 8rem) var(--page-gutter) 4rem;
    }
    .universe-section-heading {
      width: min(100%, 24rem);
    }
    .universe-section-heading h2 {
      margin-top: 0.8rem;
      font-size: clamp(3.3rem, 15vw, 4.3rem);
    }
    .universe-section-heading > p:last-of-type:not(.eyebrow) {
      max-width: 21rem;
      font-size: 0.8rem;
      margin-top: 1rem;
      line-height: 1.65;
    }
    .almanac-coordinates {
      margin-top: 1.2rem;
    }
    .almanac-coordinates dt {
      font-size: 0.48rem;
    }
    .almanac-coordinates dd {
      font-size: 0.62rem;
    }
    .universe-return {
      bottom: max(0.8rem, env(safe-area-inset-bottom));
      font-size: 0.5rem;
    }
    .universe-travel .atlas-heading {
      top: clamp(6.7rem, 14.5svh, 8rem);
      left: var(--page-gutter);
      width: calc(100% - 2 * var(--page-gutter));
    }
    .universe-travel .atlas-heading h2 {
      max-width: 10ch;
      font-size: clamp(3rem, 12.8vw, 4rem);
    }
    .universe-travel .atlas-heading > p:last-child {
      max-width: 17rem;
      margin-top: 0.9rem;
      font-size: 0.76rem;
    }
    .travel-directory {
      bottom: 4.5rem;
      left: var(--page-gutter);
      right: var(--page-gutter);
      width: auto;
    }
    .travel-directory[open] {
      max-height: 48svh;
    }
  }
  @media (max-height: 740px) and (max-width: 700px) {
    .universe-home {
      padding-top: 7rem;
    }
    .universe-home h1 {
      font-size: clamp(4.75rem, 22vw, 5.5rem);
    }
    .universe-role {
      max-width: 17rem;
      margin-top: 1.3rem;
      font-size: 0.76rem;
    }
    .universe-about {
      padding-top: 6.25rem;
    }
  }
  :global(html[data-world-scene]) .universe-about {
    padding: 0;
  }
  :global(html[data-world-scene]) .universe-about .about-heading {
    position: absolute;
    top: clamp(76px, 10svh, 96px);
    left: 50%;
    width: min(560px, 90vw);
    transform: translateX(-50%);
    text-align: center;
    pointer-events: none;
    z-index: 8;
  }
  :global(html[data-world-scene]) .about-heading::before {
    content: none;
  }
  :global(html[data-world-scene]) .universe-about .about-heading h2 {
    margin: 6px 0 0;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }
  :global(html[data-world-scene]) .about-heading .eyebrow {
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }
  :global(html[data-world-scene])
    .universe-about
    .about-heading
    > p:last-of-type:not(.eyebrow) {
    margin: 9px auto 0;
    max-width: 510px;
    font-size: 13px;
    line-height: 1.5;
  }
  :global(html[data-world-scene]) .almanac-coordinates {
    justify-content: center;
    margin: 8px 0 0;
  }
  :global(html[data-world-scene]) .almanac-coordinates > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  :global(html[data-world-scene]) .almanac-coordinates dt {
    font-size: 8px;
    margin: 0;
  }
  :global(html[data-world-scene]) .almanac-coordinates dd {
    font-size: 11px;
    margin: 0;
  }
  @media (max-width: 700px) {
    :global(html[data-world-scene]) .universe-about .about-heading {
      top: 70px;
    }
    :global(html[data-world-scene]) .universe-about .about-heading h2 {
      margin-top: 4px;
      font-size: 26px;
      line-height: 1.05;
    }
    :global(html[data-world-scene]) .about-heading .eyebrow {
      font-size: 8px;
      line-height: 1.3;
    }
    :global(html[data-world-scene])
      .universe-about
      .about-heading
      > p:last-of-type:not(.eyebrow) {
      margin-top: 7px;
      font-size: 11px;
      line-height: 1.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-universe :global(*) {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
