---
import { render, type CollectionEntry } from "astro:content";
import DemoLauncher from "@/components/demos/DemoLauncher";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, year, status, role, stack, cover, links, demo, draft } =
  entry.data;

const actionLabel = (url: string) => {
  const hostname = new URL(url).hostname;
  if (hostname === "arxiv.org") return "Read paper";
  if (hostname.endsWith("youtube.com") || hostname === "youtu.be")
    return "Watch demonstration";
  return "Visit project";
};
---

<article class="project-case-study" data-project-case-study>
  <header class="project-case-hero">
    <a class="project-case-back" href="/projects" data-astro-reload>
      <span aria-hidden="true">←</span> Project observatory
    </a>
    <div class="project-case-orbit" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="project-case-title">
      <p class="eyebrow">Project signal / {year}</p>
      <h1>{title}</h1>
    </div>
    <div class="project-case-intro">
      <p>{summary}</p>
      <dl class="project-case-meta">
        <div><dt>Role</dt><dd>{role}</dd></div>
        <div><dt>Status</dt><dd>{status}</dd></div>
        <div class="project-case-tech">
          <dt>Tech stack</dt>
          <dd>
            <ul>
              {stack.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
      {
        links.live && (
          <a
            class="project-case-action"
            href={links.live}
            target="_blank"
            rel="noreferrer"
          >
            {actionLabel(links.live)} <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        links.repository && (
          <a
            class="project-case-text-link"
            href={links.repository}
            target="_blank"
            rel="noreferrer"
          >
            Source <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
    {draft && <span class="project-case-draft">Draft preview</span>}
  </header>

  <figure class="project-case-cover">
    <span class="project-case-coordinate">FIG. 001 / SYSTEM VIEW</span>
    <img
      src={cover.src}
      width={cover.width}
      height={cover.height}
      alt={cover.alt}
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <div class="project-case-body">
    <div class="project-case-copy"><Content /></div>
  </div>

  {
    demo.type !== "none" && (
      <div class="project-case-demo">
        <DemoLauncher client:visible demo={demo} tone="cosmic" />
      </div>
    )
  }

  <footer class="project-case-next">
    <p class="eyebrow">End of signal</p>
    <a href="/projects" data-astro-reload>
      Return to the constellation field <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>

<style>
  .project-case-study {
    --case-paper: #f0eadc;
    --case-muted: #f0eadc9c;
    --case-body: #f0eadcd1;
    --case-line: #f0eadc2e;
    position: relative;
    min-height: 100svh;
    overflow: clip;
    color: var(--case-paper);
    background: linear-gradient(180deg, transparent 0 80svh, #07090df0 110svh);
  }
  .project-case-hero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 1.5vw, 1.5rem);
    min-height: calc(100svh - 5.5rem);
    padding: clamp(3rem, 9vh, 7rem) var(--page-gutter) clamp(4rem, 9vh, 8rem);
    align-content: center;
  }
  .project-case-back {
    position: absolute;
    z-index: 2;
    top: clamp(6.5rem, 12vh, 8rem);
    left: var(--page-gutter);
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    color: var(--case-muted);
    font: 0.68rem/1 var(--font-code);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 250ms ease,
      transform 450ms var(--ease-out-expo);
  }
  .project-case-back:hover,
  .project-case-back:focus-visible {
    color: #ff7656;
    transform: translateX(-0.35rem);
  }
  .project-case-title {
    position: relative;
    z-index: 1;
    grid-column: 1 / 8;
    align-self: center;
  }
  .project-case-title .eyebrow,
  .project-case-next .eyebrow {
    color: #ff7656;
  }
  .project-case-title h1 {
    max-width: 10ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8vw, 8rem);
    font-weight: 520;
    line-height: 0.82;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .project-case-intro {
    position: relative;
    z-index: 1;
    grid-column: 8 / -1;
    align-self: center;
  }
  .project-case-intro > p {
    max-width: 38rem;
    margin: 0;
    color: var(--case-body);
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.58;
  }
  .project-case-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin: 2.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--case-line);
  }
  .project-case-meta dt {
    color: #c4d37b;
    font: 0.6rem/1 var(--font-code);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .project-case-meta dd {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .project-case-tech {
    grid-column: 1 / -1;
    padding-top: 1rem;
    border-top: 1px solid var(--case-line);
  }
  .project-case-tech ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .project-case-tech li {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--case-line);
    color: var(--case-body);
    font: 0.65rem/1 var(--font-code);
    letter-spacing: 0.04em;
  }
  .project-case-action,
  .project-case-text-link {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    margin-top: 1.8rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .project-case-action {
    padding: 0.95rem 1.15rem;
    color: #10130e;
    background: #c4d37b;
  }
  .project-case-text-link {
    margin-left: 1.2rem;
    color: var(--case-paper);
  }
  .project-case-action span,
  .project-case-text-link span {
    transition: transform 350ms var(--ease-out-expo);
  }
  .project-case-action:hover span,
  .project-case-action:focus-visible span,
  .project-case-text-link:hover span,
  .project-case-text-link:focus-visible span {
    transform: translate(0.25rem, -0.25rem);
  }
  .project-case-orbit {
    position: absolute;
    top: 50%;
    left: 63%;
    width: min(52vw, 48rem);
    aspect-ratio: 1;
    opacity: 0.44;
    transform: translate(-50%, -50%) rotate(-13deg);
    pointer-events: none;
  }
  .project-case-orbit::before,
  .project-case-orbit span {
    position: absolute;
    inset: 0;
    border: 1px solid var(--case-line);
    border-radius: 50%;
    content: "";
  }
  .project-case-orbit span:nth-child(1) {
    transform: scaleX(0.38);
  }
  .project-case-orbit span:nth-child(2) {
    transform: scaleY(0.38);
  }
  .project-case-orbit span:nth-child(3) {
    inset: 49% auto auto 0;
    width: 100%;
    height: 2px;
    border: 0;
    border-radius: 0;
    background: linear-gradient(90deg, transparent, #ff7656, transparent);
  }
  .project-case-draft {
    position: absolute;
    right: var(--page-gutter);
    bottom: 2rem;
    padding: 0.5rem 0.7rem;
    color: #11110f;
    background: #ff7656;
    font: 0.65rem/1 var(--font-code);
    text-transform: uppercase;
  }
  .project-case-cover {
    position: relative;
    width: min(92rem, calc(100% - var(--page-gutter) * 2));
    margin: 0 auto;
    padding: clamp(0.55rem, 1vw, 1rem);
    border: 1px solid var(--case-line);
    background: #080b10d9;
    box-shadow: 0 3rem 8rem #0008;
  }
  .project-case-cover::before,
  .project-case-cover::after {
    position: absolute;
    z-index: 1;
    width: 3rem;
    height: 3rem;
    border-color: #ff7656;
    content: "";
    pointer-events: none;
  }
  .project-case-cover::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid;
    border-left: 2px solid;
  }
  .project-case-cover::after {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid;
    border-bottom: 2px solid;
  }
  .project-case-cover img {
    width: 100%;
    height: auto;
    background: #07090d;
  }
  .project-case-coordinate {
    position: absolute;
    z-index: 2;
    top: 1.6rem;
    left: 1.7rem;
    padding: 0.45rem 0.6rem;
    color: #f0eadc;
    background: #07090dcc;
    font: 0.58rem/1 var(--font-code);
    letter-spacing: 0.13em;
  }
  .project-case-body {
    width: min(62rem, calc(100% - var(--page-gutter) * 2));
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 0;
  }
  .project-case-copy {
    width: 100%;
    color: var(--case-body);
    font-size: clamp(1.05rem, 1.2vw, 1.15rem);
    line-height: 1.7;
  }
  .project-case-copy :global(h2) {
    margin: 2.15em 0 0.65em;
    padding-top: 0.75em;
    border-top: 1px solid var(--case-line);
    color: var(--case-paper);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: 520;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .project-case-copy :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .project-case-copy :global(p) {
    max-width: 76ch;
    margin: 0 0 1.35em;
  }
  .project-case-copy :global(a) {
    color: #c4d37b;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .project-case-copy :global(em) {
    color: var(--case-paper);
  }
  .project-case-demo {
    padding: 0 var(--page-gutter) clamp(5rem, 10vw, 9rem);
  }
  .project-case-next {
    padding: clamp(4rem, 8vw, 7rem) var(--page-gutter);
    border-top: 1px solid var(--case-line);
    background: #07090dbd;
  }
  .project-case-next a {
    display: inline-block;
    max-width: 12ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
    text-decoration: none;
  }
  .project-case-next a span {
    color: #c4d37b;
  }
  @media (max-width: 900px) {
    .project-case-hero {
      align-content: end;
    }
    .project-case-title {
      grid-column: 1 / -1;
    }
    .project-case-intro {
      grid-column: 2 / -2;
      margin-top: 2rem;
    }
    .project-case-orbit {
      top: 32%;
      left: 70%;
      width: 72vw;
    }
  }
  @media (max-width: 700px) {
    .project-case-hero {
      display: block;
      min-height: auto;
      padding-top: 8rem;
    }
    .project-case-title h1 {
      max-width: 10ch;
      font-size: clamp(3.25rem, 16vw, 4.5rem);
    }
    .project-case-intro {
      margin-top: 2rem;
    }
    .project-case-meta {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .project-case-tech {
      grid-column: auto;
    }
    .project-case-orbit {
      top: 11rem;
      left: 82%;
      width: 85vw;
    }
    .project-case-coordinate {
      top: 1rem;
      left: 1rem;
    }
    .project-case-body {
      width: calc(100% - var(--page-gutter) * 2);
    }
    .project-case-copy {
      font-size: 1.05rem;
    }
    .project-case-action,
    .project-case-text-link {
      margin-top: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-case-back,
    .project-case-action span,
    .project-case-text-link span {
      transition: none;
    }
  }
</style>
