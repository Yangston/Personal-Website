---
import type { CollectionEntry } from "astro:content";
import {
  createProjectConstellationWorldPoints,
  resolveProjectConstellation,
  type ProjectConstellationVisual,
} from "@/lib/portfolio-universe/project-constellations";
import {
  createCompositionFrame,
  SCENE_MANIFEST,
} from "@/lib/portfolio-universe/scene-manifest";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const projectConstellations = projects.map((entry, index) => ({
  entry,
  constellation: resolveProjectConstellation(entry.id, index),
}));

const initialFrames = {
  desktop: {
    width: 1440,
    frame: createCompositionFrame("projects", 1440, 900, SCENE_MANIFEST),
  },
  mobile: {
    width: 390,
    frame: createCompositionFrame("projects", 390, 900, SCENE_MANIFEST),
  },
};
const initialProjectionStyle = (
  constellation: ProjectConstellationVisual,
  mode: keyof typeof initialFrames,
) => {
  const { width: viewportWidth, frame } = initialFrames[mode];
  const points = createProjectConstellationWorldPoints(
    constellation,
    SCENE_MANIFEST.anchors.projects,
  ).map(frame.projectToWorld);
  const xs = points.map(({ x }) => x);
  const ys = points.map(({ y }) => y);
  const zs = points.map(({ z }) => z);
  // projectAnchor projects the corners of each world's axis-aligned box.
  const corners = [Math.min(...xs), Math.max(...xs)].flatMap((x) =>
    [Math.min(...ys), Math.max(...ys)].flatMap((y) =>
      [Math.min(...zs), Math.max(...zs)].map((z) =>
        frame.project({ x, y, z })!,
      ),
    ),
  );
  const left = Math.min(...corners.map(({ x }) => x));
  const right = Math.max(...corners.map(({ x }) => x));
  const top = Math.min(...corners.map(({ y }) => y));
  const bottom = Math.max(...corners.map(({ y }) => y));
  const vh = (value: number) => `${((value / 900) * 100).toFixed(6)}vh`;
  return [
    `--project-${mode}-width:max(44px,${vh(right - left)})`,
    `--project-${mode}-height:max(44px,${vh(bottom - top)})`,
    `--project-${mode}-left:calc(50vw + ${vh((left + right) / 2 - viewportWidth / 2)} - var(--project-${mode}-width) / 2)`,
    `--project-${mode}-top:calc(${vh((top + bottom) / 2)} - var(--project-${mode}-height) / 2)`,
  ];
};

const constellationStyle = (
  constellation: ProjectConstellationVisual,
  index: number,
) =>
  [
    ...initialProjectionStyle(constellation, "desktop"),
    ...initialProjectionStyle(constellation, "mobile"),
    `--constellation-x:${constellation.position.x}%`,
    `--constellation-y:${constellation.position.y}%`,
    `--constellation-size:${constellation.position.size}vw`,
    `--constellation-mobile-x:${constellation.mobilePosition.x}%`,
    `--constellation-mobile-y:${constellation.mobilePosition.y}%`,
    `--constellation-mobile-size:${constellation.mobilePosition.size}vw`,
    `--constellation-depth:${constellation.depth}px`,
    `--constellation-layer:${1000 + Math.round(constellation.depth)}`,
    `--constellation-rotation:${constellation.rotation}deg`,
    `--constellation-accent:#ebc58f`,
    `--constellation-delay:${constellation.drawDelayMs + index * 70}ms`,
  ].join(";");
---

<section
  id="projects"
  class="universe-scene project-sky"
  data-universe-scene="projects"
  data-scene-active="false"
  data-project-sky
  aria-labelledby="project-sky-title"
>
  <header class="project-sky-heading universe-section-heading">
    <p class="eyebrow">Selected work</p>
    <h2 id="project-sky-title" tabindex="-1">Things I’ve <em>built.</em></h2>
    <p>
      Software, intelligent systems, and ideas made tangible. Follow a
      constellation.
    </p>
  </header>

  {
    projectConstellations.length ? (
      <ol class="project-constellations" aria-label="Published projects">
        {projectConstellations.map(({ entry, constellation }, index) => {
          const { title, year, status, stack, summary } = entry.data;
          return (
            <li
              data-constellation-depth={constellation.depth}
              data-project-id={entry.id}
              data-project-label-placement={
                constellation.mobilePosition.y >= 60 ? "above" : "below"
              }
              data-universe-anchor={`project:${entry.id}`}
              style={constellationStyle(constellation, index)}
            >
              <a
                class="project-constellation"
                data-project-constellation
                data-project-motif={constellation.motif}
                data-project-motion={constellation.hoverMotion}
                href={`/projects/${entry.id}`}
                aria-label={`Explore ${title}, ${year}`}
              >
                <svg
                  class="constellation-drawing"
                  viewBox="0 0 240 160"
                  aria-hidden="true"
                >
                  <g class="constellation-halos">
                    {constellation.points.map(([x, y], pointIndex) => (
                      <circle
                        cx={x}
                        cy={y}
                        r={pointIndex % 4 === 2 ? 9 : 6}
                        style={`--star-delay:${constellation.drawDelayMs + pointIndex * 54}ms`}
                      />
                    ))}
                  </g>
                  <g class="constellation-lines">
                    {constellation.edges.map(([from, to], edgeIndex) => (
                      <line
                        x1={constellation.points[from][0]}
                        y1={constellation.points[from][1]}
                        x2={constellation.points[to][0]}
                        y2={constellation.points[to][1]}
                        pathLength="1"
                        style={`--edge-delay:${constellation.drawDelayMs + edgeIndex * 46}ms`}
                      />
                    ))}
                  </g>
                  <g class="constellation-rays" fill="#fff1ce">
                    {constellation.points
                      .filter((_, i) => i % 4 === 0)
                      .map(([x, y]) => (
                        <path
                          d={`M${x} ${y - 12}l1.4 10.6 8.6 1.4-8.6 1.4-1.4 10.6-1.4-10.6-8.6-1.4 8.6-1.4Z`}
                        />
                      ))}
                  </g>
                  <g class="constellation-stars">
                    {constellation.points.map(([x, y], pointIndex) => (
                      <circle
                        cx={x}
                        cy={y}
                        r={pointIndex % 4 === 2 ? 3.2 : 2.15}
                        style={`--star-delay:${constellation.drawDelayMs + pointIndex * 54}ms`}
                      />
                    ))}
                  </g>
                </svg>

                <span class="project-constellation-copy">
                  <strong
                    class="project-constellation-title"
                    aria-hidden="true"
                  >
                    <span class="project-constellation-title-text">
                      {title}
                    </span>
                  </strong>
                  <span class="project-constellation-meta">
                    {year} &middot; {status}
                  </span>
                  <span class="project-constellation-details">
                    <span class="project-constellation-summary">{summary}</span>
                    <small>{stack.slice(0, 4).join(" · ")}</small>
                  </span>
                </span>
              </a>
              <button
                class="project-info"
                type="button"
                data-project-info={entry.id}
                aria-label={`Preview ${title}`}
                aria-controls={`project-preview-${entry.id}`}
                aria-expanded="false"
              >
                i
              </button>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="project-sky-empty">New constellations are being charted.</p>
    )
  }

  {
    projects.map(({ id, data }) => (
      <aside
        class="project-hover-preview"
        id={`project-preview-${id}`}
        data-project-preview={id}
        data-universe-interaction={`project:${id}`}
        aria-labelledby={`preview-title-${id}`}
        hidden
      >
        <button
          type="button"
          class="preview-close"
          data-preview-close
          aria-label={`Close ${data.title} preview`}
        >
          Close
        </button>
        <p class="eyebrow">Selected work</p>
        <h3 id={`preview-title-${id}`}>{data.title}</h3>
        <p class="project-preview-summary">{data.summary}</p>
        <dl class="project-preview-facts">
          <div>
            <>
              <dt>Year</dt>
              <dd>{data.year}</dd>
            </>
          </div>
          <div>
            <>
              <dt>Status</dt>
              <dd>{data.status}</dd>
            </>
          </div>
        </dl>
        <h3 class="project-preview-stack-title">Built with</h3>
        <ul class="project-preview-stack" aria-label="Technology stack">
          {data.stack.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
        <a class="project-preview-link" href={`/projects/${id}`}>
          Open case study <span aria-hidden="true">↗</span>
        </a>
      </aside>
    ))
  }

  <a class="project-return universe-return" href="/#home" data-universe-link>
    <span aria-hidden="true">←</span> Return to system
  </a>
</section>

<style>
  .project-hover-preview[hidden] {
    display: none;
  }
  .project-hover-preview {
    position: absolute;
    z-index: 3000;
    right: 3vw;
    top: 30svh;
    width: min(25vw, 340px);
    max-height: 57svh;
    overflow: auto;
    padding: 1.5rem;
    color: #fff0d6;
    border-left: 1px solid #eed3a34d;
    background: linear-gradient(110deg, #17131fd9, #17131f70);
    backdrop-filter: blur(14px);
    border-radius: 2px;
  }
  .project-hover-preview > h3:not(.project-preview-stack-title) {
    font: 500 clamp(1.8rem, 2.8vw, 3rem)/1.05 var(--font-display);
    margin: 0.8rem 0 1rem;
  }
  .project-hover-preview .eyebrow {
    font: 0.6rem var(--font-code);
    letter-spacing: 0.15em;
  }
  .project-hover-preview .project-preview-link {
    color: #ffe0a3;
  }
  .preview-close {
    float: right;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 1.6rem;
  }
  .project-info {
    display: none;
    position: absolute;
    right: auto;
    bottom: auto;
    visibility: hidden;
    border: 0;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    background: transparent;
    color: #ffe0a3;
    cursor: pointer;
    isolation: isolate;
    font: 13px var(--font-code);
  }
  .project-info[data-info-ready="true"] {
    visibility: visible;
  }
  .project-info::before {
    content: "";
    position: absolute;
    inset: 10px;
    z-index: -1;
    border: 1px solid #eed3a380;
    border-radius: 50%;
    background: #1b1822a0;
  }
  .project-info:focus-visible,
  .preview-close:focus-visible {
    outline: 2px solid #ffe0a3;
    outline-offset: 3px;
  }
  @media (hover: none), (pointer: coarse) {
    .project-info {
      display: block;
    }
  }
  @media (max-width: 700px) {
    .project-hover-preview {
      position: fixed;
      top: auto;
      bottom: 5.3rem;
      right: 1rem;
      left: 1rem;
      width: auto;
      max-height: 44svh;
      padding: 1rem 1.25rem;
    }
  }
  :global(html:not([data-world-scene])) .project-info {
    display: none;
  }

  .project-sky {
    position: relative;
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(32rem, 1.28fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
    min-height: 100svh;
    padding: clamp(8rem, 15vh, 11rem) var(--page-gutter) 7rem;
    overflow: clip;
    color: var(--universe-ink, #171615);
    scroll-margin-top: 4.5rem;
  }

  .project-sky-heading {
    position: relative;
    z-index: 20;
  }

  .project-sky-heading .eyebrow {
    margin: 0;
    color: inherit;
    font: 500 0.65rem/1.6 var(--font-code);
    letter-spacing: 0.2em;
  }

  .project-sky-heading h2 {
    max-width: 9ch;
    margin: 1.2rem 0 0;
    font-family: var(--font-universe-display, var(--font-display));
    font-size: clamp(4rem, 5.8vw, 6.75rem);
    font-weight: 600;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 48;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .project-sky-heading h2[tabindex="-1"]:focus {
    outline: none;
  }

  .project-sky-heading h2 em {
    color: var(--universe-signal, #ef4529);
    font-weight: inherit;
  }

  .project-sky-heading > p:last-child {
    max-width: 23rem;
    margin: 1.6rem 0 0;
    color: #49413f;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .project-constellations {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vh, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-constellations > li:first-child {
    grid-column: 1 / -1;
    width: 68%;
    margin-left: auto;
  }

  .project-constellations > li {
    min-width: 0;
  }

  .project-constellation {
    position: relative;
    display: block;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    color: inherit;
    text-decoration: none;
    transform-origin: center;
  }

  .project-constellation:focus-visible {
    border-radius: 0.35rem;
    outline: 2px solid var(--constellation-accent);
    outline-offset: 0.3rem;
  }

  .constellation-drawing {
    display: block;
    width: 100%;
    max-height: 15rem;
    overflow: visible;
    filter: drop-shadow(
      0 0 0.75rem
        color-mix(in srgb, var(--constellation-accent) 46%, transparent)
    );
    transition: filter 320ms ease;
  }

  .constellation-lines line {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(
      in srgb,
      var(--constellation-accent) 62%,
      var(--universe-ink, #171615)
    );
    stroke-width: 0.95px;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition:
      stroke 220ms ease,
      stroke-width 220ms ease;
  }

  .constellation-halos circle {
    fill: color-mix(in srgb, var(--constellation-accent) 32%, transparent);
    filter: blur(2.4px);
    opacity: 0.76;
  }

  .constellation-stars circle {
    fill: #fff;
    stroke: var(--constellation-accent);
    stroke-width: 1.15px;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 220ms ease,
      transform 380ms var(--ease-out-expo);
  }

  .project-constellation-copy {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    padding: 0.9rem 0.15rem 0.1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--universe-ink, #171615) 30%, transparent);
  }

  .project-constellation-meta,
  .project-constellation-copy small {
    color: #736069;
    font: 0.52rem/1.5 var(--font-code);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-constellation-copy strong {
    font-family: var(--font-universe-display, var(--font-display));
    font-size: clamp(1.7rem, 2.6vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .project-constellation-title-text {
    display: block;
    white-space: normal;
  }

  .project-constellation-meta {
    align-self: end;
    text-align: right;
  }

  .project-constellation-details {
    display: grid;
    grid-column: 1 / -1;
    gap: 0.45rem;
    transition:
      opacity 180ms ease,
      transform 360ms var(--ease-out-expo);
  }

  .project-constellation-summary {
    max-width: 48ch;
    color: color-mix(in srgb, var(--universe-ink, #171615) 66%, transparent);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .project-constellation:is(:hover, :focus-visible) .constellation-drawing {
    filter: drop-shadow(
      0 0 1.35rem
        color-mix(in srgb, var(--constellation-accent) 78%, transparent)
    );
  }

  .project-constellation:is(:hover, :focus-visible) .constellation-lines line {
    stroke: var(--constellation-accent);
    stroke-width: 1.15px;
  }

  .project-constellation:is(:hover, :focus-visible)
    .constellation-stars
    circle {
    fill: var(--constellation-accent);
    transform: scale(1.7);
  }

  .project-constellation[aria-expanded="true"] .project-constellation-title {
    color: var(--constellation-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .project-sky-empty {
    position: relative;
    z-index: 2;
    font-family: var(--font-universe-display, var(--font-display));
    font-size: 2rem;
  }

  .project-return {
    position: relative;
    z-index: 30;
    display: inline-flex;
    grid-column: 1 / -1;
    gap: 0.65rem;
    align-items: center;
    justify-self: end;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--universe-ink, #171615);
    font: 700 0.58rem/1 var(--font-code);
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .project-return span {
    color: var(--universe-signal, #ef4529);
    font-size: 0.92rem;
    transition: transform 280ms var(--ease-out-expo);
  }

  .project-return:is(:hover, :focus-visible) span {
    transform: translateX(-0.3rem);
  }

  .project-return:focus-visible {
    outline: 2px solid var(--universe-signal, #ef4529);
    outline-offset: 0.28rem;
  }

  :global(html[data-world-scene]) .project-sky {
    display: block;
    height: 100svh;
    min-height: 0;
    padding: 0;
    perspective: 1050px;
    perspective-origin: 69% 48%;
    transform-style: preserve-3d;
  }

  :global(html[data-world-scene]) .constellation-lines line {
    stroke: #f4d29d;
  }

  :global(html[data-world-scene]) .project-sky-heading {
    position: absolute;
    top: clamp(9rem, 23svh, 15rem);
    left: var(--page-gutter);
    width: min(31rem, 39vw);
    pointer-events: none;
  }

  :global(html[data-world-scene]) .project-return {
    position: absolute;
    bottom: 1.4rem;
    left: var(--page-gutter);
    justify-self: auto;
  }

  :global(html[data-world-scene]) .project-constellations {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  :global(html[data-world-scene]) .project-constellations > li {
    --universe-anchor-left: var(--project-desktop-left);
    --universe-anchor-top: var(--project-desktop-top);
    --universe-anchor-width: var(--project-desktop-width);
    --universe-anchor-height: var(--project-desktop-height);
    position: absolute;
    z-index: var(--constellation-layer);
    top: var(--universe-anchor-top);
    left: var(--universe-anchor-left);
    width: var(--universe-anchor-width);
    height: var(--universe-anchor-height);
    margin: 0;
    pointer-events: auto;
    transform: none;
  }

  :global(html[data-world-scene])
    .project-constellations
    > li:is(:hover, :focus-within) {
    z-index: 2000;
  }

  :global(html[data-world-scene])
    .project-constellations
    > li[data-universe-anchor-projected="true"]::after {
    content: none;
  }

  :global(html[data-world-scene]) .project-constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    transform: translateZ(0);
    transform-style: preserve-3d;
    transition: transform 620ms var(--ease-out-expo);
  }

  :global(html[data-world-scene])
    .project-constellation:is(:hover, :focus-visible) {
    transform: none;
  }

  :global(
    [data-portfolio-universe][data-renderer-ready="true"]
      .project-constellation:is(:hover, :focus-visible)
  ) {
    outline: none;
  }

  :global(html[data-world-scene]) .project-constellation-copy {
    --project-label-width: clamp(11rem, 17vw, 16rem);
    grid-template-columns: 1fr;
    position: absolute;
    top: calc(100% + 0.35rem);
    left: clamp(
      calc(1rem + var(--project-label-width) / 2 - var(--universe-anchor-left)),
      50%,
      calc(
        100vw - 1rem - var(--project-label-width) / 2 -
          var(--universe-anchor-left)
      )
    );
    width: min(var(--project-label-width), calc(100vw - 2rem));
    margin: 0;
    padding: 0;
    border-top: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    text-align: center;
    color: #fff2da;
    text-shadow:
      0 1px 3px #302735,
      0 0 12px #302735;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%);
  }

  :global(
    [data-portfolio-universe][data-renderer-ready="true"]
      .project-constellation:focus-visible
      .project-constellation-copy
  ) {
    border-radius: 0.22rem;
    outline: 2px solid #ffe0a3;
    outline-offset: 0.22rem;
    box-shadow: none;
  }

  :global(html[data-world-scene]) .project-constellation-copy strong {
    font-size: clamp(1.45rem, 2.2vw, 2.55rem);
  }

  :global(html[data-world-scene]) .project-constellation-meta {
    text-align: center;
    color: #ffedce;
  }

  :global(html[data-world-scene])
    .project-constellation:is(:hover, :focus-visible)
    .project-constellation-title {
    color: #ffe0a3;
  }

  :global(html[data-world-scene]) .project-constellation-details {
    display: none;
  }

  :global(
    [data-portfolio-universe][data-enhanced="true"][data-renderer-ready="true"]
      .constellation-drawing
  ) {
    visibility: hidden;
    opacity: 0;
    animation: none;
  }

  @media (max-width: 980px) {
    .project-sky {
      grid-template-columns: 1fr;
      align-content: start;
    }

    .project-sky-heading {
      max-width: 44rem;
    }

    .project-constellations {
      width: 100%;
      max-width: 48rem;
      margin-left: auto;
    }
  }

  @media (max-width: 700px) {
    .project-sky {
      min-height: max(100svh, 48rem);
      padding-top: 7rem;
      scroll-margin-top: 3.8rem;
    }

    .project-sky-heading h2 {
      font-size: clamp(3.7rem, 18vw, 5.5rem);
    }

    .project-constellations {
      grid-template-columns: 1fr;
    }

    .project-constellations > li:first-child {
      grid-column: auto;
      width: 100%;
    }

    .constellation-drawing {
      height: 9rem;
    }

