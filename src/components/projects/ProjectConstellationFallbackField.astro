---
import type { CollectionEntry } from "astro:content";
import { resolveProjectConstellation } from "@/lib/portfolio-universe/project-constellations";

interface Props {
  projects: CollectionEntry<"projects">[];
  class?: string;
}

const { projects, class: className } = Astro.props;
---

<span
  class:list={["project-constellation-fallback-field", className]}
  data-project-constellation-fallback-field
  data-universe-fallback-visual
  aria-hidden="true"
>
  {
    projects.map((entry, index) => {
      const constellation = resolveProjectConstellation(entry.id, index);
      return (
        <svg
          class="project-constellation-fallback-motif"
          data-project-fallback-id={entry.id}
          viewBox="0 0 240 160"
          style={`--fallback-x:${constellation.position.x}%;--fallback-y:${constellation.position.y}%;--fallback-accent:${constellation.accent}`}
        >
          <g class="fallback-constellation-halos">
            {constellation.points.map(([x, y], pointIndex) => (
              <circle cx={x} cy={y} r={pointIndex % 4 === 2 ? 8 : 5.5} />
            ))}
          </g>
          <g class="fallback-constellation-lines">
            {constellation.edges.map(([from, to]) => (
              <line
                x1={constellation.points[from][0]}
                y1={constellation.points[from][1]}
                x2={constellation.points[to][0]}
                y2={constellation.points[to][1]}
              />
            ))}
          </g>
          <g class="fallback-constellation-stars">
            {constellation.points.map(([x, y], pointIndex) => (
              <circle cx={x} cy={y} r={pointIndex % 4 === 2 ? 3.1 : 2.05} />
            ))}
          </g>
        </svg>
      );
    })
  }
</span>

<style>
  .project-constellation-fallback-field {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1.45;
    pointer-events: none;
  }

  .project-constellation-fallback-motif {
    position: absolute;
    top: var(--fallback-y);
    left: var(--fallback-x);
    width: 56%;
    overflow: visible;
    filter: drop-shadow(
      0 0 0.55rem color-mix(in srgb, var(--fallback-accent) 34%, transparent)
    );
    transform: translate(-50%, -50%);
  }

  .project-constellation-fallback-motif:nth-child(2) {
    width: 43%;
  }

  .project-constellation-fallback-motif:nth-child(3) {
    width: 46%;
  }

  .fallback-constellation-lines line {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--fallback-accent) 62%, #171615);
    stroke-width: 0.8px;
  }

  .fallback-constellation-halos circle {
    fill: color-mix(in srgb, var(--fallback-accent) 20%, transparent);
    filter: blur(2.2px);
  }

  .fallback-constellation-stars circle {
    fill: #f5f0e8;
    stroke: var(--fallback-accent);
    stroke-width: 1.1px;
  }
</style>
