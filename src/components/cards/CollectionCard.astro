---
import type { CollectionEntry } from "astro:content";
import manifest from "@/data/photography-manifest.json";
interface Props {
  entry: CollectionEntry<"photography">;
  index: number;
}
const { entry, index } = Astro.props;
const { name, dateRange, description, coverId, regions } = entry.data;
const cover = manifest.find((item) => item.id === coverId)!;
---

<article class="group relative">
  <a href={`/photography/${entry.id}`} class="block">
    <div class="relative aspect-[4/5] overflow-hidden bg-ink">
      <img
        src={cover.variants.at(-1)?.src}
        srcset={cover.variants
          .map((item) => `${item.src} ${item.width}w`)
          .join(", ")}
        sizes="(min-width: 768px) 48vw, 92vw"
        width={cover.width}
        height={cover.height}
        alt={cover.alt}
        loading="lazy"
        class="h-full w-full object-cover transition duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04] group-hover:rotate-1"
      />
      <span
        class="absolute left-3 top-3 bg-paper px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-ink"
        >Geographic archive</span
      >
      <span
        aria-hidden="true"
        class="absolute bottom-0 right-0 grid size-16 translate-x-full place-items-center bg-cobalt text-3xl text-white transition-transform duration-500 group-hover:translate-x-0"
        >↗</span
      >
    </div>
    <div class="grid grid-cols-[auto_1fr] gap-4 border-b border-ink py-4">
      <span class="text-xs font-bold text-signal"
        >{String(index + 1).padStart(2, "0")}</span
      >
      <div>
        <h2
          class="font-display text-4xl leading-none tracking-tight md:text-5xl"
        >
          {name}
        </h2><div
          class="mt-2 flex justify-between gap-2 text-xs font-semibold uppercase tracking-wider"
        >
          <span>{regions.length} regions</span><time
            datetime={dateRange.start.toISOString()}
            >{dateRange.start.getFullYear()}</time
          >
        </div><p class="mt-3 max-w-md text-sm text-ink/70">{description}</p>
      </div>
    </div>
  </a>
</article>
