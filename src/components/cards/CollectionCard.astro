---
import type { CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"photography">; index: number; }
const { entry, index } = Astro.props;
const { title, location, date, description, cover, draft, presentation } = entry.data;
---
<article class:list={["group relative", index % 3 === 1 ? "md:translate-y-24" : "", index % 4 === 2 ? "md:col-span-2" : ""]}>
  <a href={`/photography/${entry.id}`} class="block">
    <div class="relative aspect-[4/5] overflow-hidden bg-ink">
      <img src={cover.src} width={cover.width} height={cover.height} alt={cover.alt} loading="lazy" class="h-full w-full object-cover transition duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04] group-hover:rotate-1" />
      <span class="absolute left-3 top-3 bg-paper px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-ink">{presentation.replaceAll("-", " ")}</span>
      {draft && <span class="absolute right-3 top-3 bg-signal px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-ink">Draft preview</span>}
      <span aria-hidden="true" class="absolute bottom-0 right-0 grid size-16 translate-x-full place-items-center bg-cobalt text-3xl text-white transition-transform duration-500 group-hover:translate-x-0">↗</span>
    </div>
    <div class="grid grid-cols-[auto_1fr] gap-4 border-b border-ink py-4">
      <span class="text-xs font-bold text-signal">{String(index + 1).padStart(2, "0")}</span>
      <div>
        <h2 class="font-display text-4xl leading-none tracking-tight md:text-5xl">{title}</h2>
        <div class="mt-2 flex flex-wrap justify-between gap-2 text-xs font-semibold uppercase tracking-wider"><span>{location}</span><time datetime={date.toISOString()}>{date.getFullYear()}</time></div>
        <p class="mt-3 max-w-md text-sm text-ink/70">{description}</p>
      </div>
    </div>
  </a>
</article>
